# trading-lab service environment (TEMPLATE - copy, never commit the real file).
#
#   sudo install -d -m 750 -o root -g tradinglab /etc/trading-lab
#   sudo install -m 640 -o root -g tradinglab deploy/trading-lab.env.example /etc/trading-lab/trading-lab.env
#   sudoedit /etc/trading-lab/trading-lab.env
#
# Only the Qwen model endpoint needs credentials. trading-lab never needs and
# never reads exchange API keys: market data comes from public endpoints only.

QWEN_API_URL=https://your-qwen-endpoint.example/v1
QWEN_MODEL=your-model-name
QWEN_API_KEY=change-me

# Or Claude: [agents] provider = "anthropic" in the config, then
# ANTHROPIC_API_KEY=change-me
# ANTHROPIC_MODEL=your-model-name
# The URL is optional (default https://api.anthropic.com):
# ANTHROPIC_API_URL=https://api.anthropic.com

# Optional push alerts ([alerts] enabled = true in the config). The URL usually contains a
# secret (e.g. an ntfy topic name or a Slack/Discord webhook token), so it lives here too.
# TRADING_LAB_ALERT_URL=https://ntfy.sh/pick-a-long-random-topic-name

# Optional e-mail alerts ([alerts] channels = ["email"] or ["webhook", "email"]).
# STARTTLS on port 587 by default; TRADING_LAB_SMTP_SECURITY=ssl uses port 465.
# For Gmail, use an app password, not your account password.
# TRADING_LAB_SMTP_HOST=smtp.example.com
# TRADING_LAB_SMTP_USER=you@example.com
# TRADING_LAB_SMTP_PASSWORD=change-me
# TRADING_LAB_ALERT_EMAIL_TO=you@example.com
# The sender defaults to TRADING_LAB_SMTP_USER (systemd allows no comments after a value):
# TRADING_LAB_ALERT_EMAIL_FROM=you@example.com
