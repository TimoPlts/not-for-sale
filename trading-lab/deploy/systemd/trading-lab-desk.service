# Evening desk report for the PAPER trader: every running paper run's last 24 hours as a funnel
# (leads -> confirmed -> cleared -> executed -> closed, with lead IDs), sent once through the configured
# [alerts] channels (e.g. Telegram). Read-only; trades nothing.
# Template: install together with trading-lab-desk.timer (see docs/DEPLOYMENT.md, section 5f):
#   sudo cp deploy/systemd/trading-lab-desk.* /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now trading-lab-desk.timer

[Unit]
Description=trading-lab evening desk report (read-only)

[Service]
Type=oneshot
User=tradinglab
Group=tradinglab
WorkingDirectory=/opt/trading-lab/trading-lab
# Only for the alert channel settings (webhook URL / SMTP / Telegram); the report itself needs no secrets.
EnvironmentFile=/etc/trading-lab/trading-lab.env
ExecStart=/opt/trading-lab/trading-lab/.venv/bin/trading-lab \
    --config /opt/trading-lab/trading-lab/config/default.toml \
    desk --all --hours 24 --alert

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
ReadOnlyPaths=/opt/trading-lab/trading-lab
